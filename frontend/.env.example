# Set these through the EAS production environment; do not commit frontend/.env.
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_STT_PROVIDER=whisper
# Google Maps — see app.config.js for how each key is wired per platform.
# Verify with: node scripts/verify_google_maps_keys.js
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Google Places (New) destination-search pilot (default OFF) — must match the
# backend's FEATURE_GOOGLE_PLACES_V1; see src/women/DestinationPicker.tsx.
EXPO_PUBLIC_PLACES_AUTOCOMPLETE_V1=false
# B-06/B-02 — Outbound Guard profile. Neither var is required: if left unset,
# src/outbound.ts and app.config.js both default to the SAFEST choice,
# internal_qa (simulated dialler/SMS/share + the QA MODE banner), unless
# EXPO_PUBLIC_OUTBOUND_MODE=live is explicitly set, in which case they fall
# back to "production" instead (no banner, no "-qa" version suffix). Set
# EXPO_PUBLIC_OUTBOUND_PROFILE explicitly on any internal QA / Preview
# deployment so it can never be silently lost this way -- e.g. a Preview
# build that also sets EXPO_PUBLIC_OUTBOUND_MODE=live for another reason
# would otherwise drop the banner along with it. See src/outbound.ts and
# src/components/dhara/QaModeBanner.tsx.
EXPO_PUBLIC_OUTBOUND_MODE=simulate
EXPO_PUBLIC_OUTBOUND_PROFILE=internal_qa