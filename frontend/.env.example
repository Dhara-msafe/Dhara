# Set these through the EAS production environment; do not commit frontend/.env.
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_STT_PROVIDER=whisper
# Google Maps — see app.config.js for how each key is wired per platform.
# Verify with: node scripts/verify_google_maps_keys.js
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Google Places (New) destination-search pilot (default OFF) — must match the
# backend's FEATURE_GOOGLE_PLACES_V1; see src/women/DestinationPicker.tsx.
EXPO_PUBLIC_PLACES_AUTOCOMPLETE_V1=false
# B-06/B-02 — Outbound Guard profile. Neither var is required: if left unset,
# src/outbound.ts and app.config.js both default to the SAFEST choice,
# internal_qa (simulated dialler/SMS/share + the QA MODE banner), unless
# EXPO_PUBLIC_OUTBOUND_MODE=live is explicitly set, in which case they fall
# back to "production" instead (no banner, no "-qa" version suffix). Set
# EXPO_PUBLIC_OUTBOUND_PROFILE explicitly on any internal QA / Preview
# deployment so it can never be silently lost this way -- e.g. a Preview
# build that also sets EXPO_PUBLIC_OUTBOUND_MODE=live for another reason
# would otherwise drop the banner along with it. See src/outbound.ts and
# src/components/dhara/QaModeBanner.tsx.
EXPO_PUBLIC_OUTBOUND_MODE=simulate
EXPO_PUBLIC_OUTBOUND_PROFILE=internal_qa
# Talk to DHARA voice companion (default OFF) — see src/voice/speechGate.ts.
EXPO_PUBLIC_VOICE_COMPANION_ENABLED=false
# Mic/audio-session arbiter used by the voice companion (default OFF in the
# app; `yarn test:voice` enables it on its own via a committed test-only
# shim — src/voice/core/__tests__/test-flags.mjs — so this line is only for
# running the real app locally with it on). See src/voice/micArbiterGuard.ts.
EXPO_PUBLIC_AUDIO_ARBITER_ENABLED=false

# ── Head Out (W2-J05) flags — names only, set real values per environment ──
# Live GPS tracking during a Head Out journey (useLivePosition / gps store).
EXPO_PUBLIC_GO1B_GPS=
# Live route + ETA + arrival-zone on the active journey screen.
EXPO_PUBLIC_GO1C_LIVE_ROUTE=
# Pick up to 3 Trusted Circle members as per-journey recipients (step 3).
EXPO_PUBLIC_TRUSTED_CIRCLE_RECIPIENT=
# Public guardian share page links.
EXPO_PUBLIC_GUARDIAN_SHARE=
# Alert simulation banner/behaviour for QA builds.
EXPO_PUBLIC_ALERT_SIMULATION_MODE=
# Head Out demo simulator (demo data + simulator UI). Keep false outside demos.
EXPO_PUBLIC_HEADOUT_DEMO=
# D-42 live tracking: Android foreground service + background location during
# an active journey (per-journey opt-in + Play prominent disclosure). OFF by
# default; turning it on in a build also needs the Play location declaration.
EXPO_PUBLIC_HEADOUT_BG_TRACKING=

# A02: for EAS builds, the location switches and the demo switch are set per
# build profile in eas.json ("env" block). The values in this file are only for
# local runs. Deployment Secrets (Emergent) and eas.json are separate stores:
# a value set in one is not set in the other.
# app.config.js refuses any non-internal_qa build with EXPO_PUBLIC_HEADOUT_DEMO=true.
