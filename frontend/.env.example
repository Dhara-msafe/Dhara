# Set these through the EAS production environment; do not commit frontend/.env.
EXPO_PUBLIC_BACKEND_URL=
EXPO_PUBLIC_STT_PROVIDER=whisper
# Google Maps — see app.config.js for how each key is wired per platform.
# Verify with: node scripts/verify_google_maps_keys.js
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
# Google Places (New) destination-search pilot (default OFF) — must match the
# backend's FEATURE_GOOGLE_PLACES_V1; see src/women/DestinationPicker.tsx.
EXPO_PUBLIC_PLACES_AUTOCOMPLETE_V1=false
# Talk to DHARA voice companion (default OFF) — see src/voice/speechGate.ts.
EXPO_PUBLIC_VOICE_COMPANION_ENABLED=false
# Mic/audio-session arbiter used by the voice companion (default OFF in the
# app; `yarn test:voice` enables it on its own via a committed test-only
# shim — src/voice/core/__tests__/test-flags.mjs — so this line is only for
# running the real app locally with it on). See src/voice/micArbiterGuard.ts.
EXPO_PUBLIC_AUDIO_ARBITER_ENABLED=false

# Head Out (Women's Shield) — all default OFF. Set per EAS build profile.
EXPO_PUBLIC_SAFETY_SESSION_V1=false
EXPO_PUBLIC_GO1B_GPS=false
EXPO_PUBLIC_GO1C_LIVE_ROUTE=false
EXPO_PUBLIC_GUARDIAN_SHARE=false
EXPO_PUBLIC_TRUSTED_CIRCLE_RECIPIENT=false
# true = in-app "Simulated — nothing sent" preview instead of a real SMS
EXPO_PUBLIC_ALERT_SIMULATION_MODE=true
