{
  "expo": {
    "name": "DHARA",
    "slug": "msafe-legal-aid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dhara_icon.png",
    "scheme": [
      "dhara",
      "msafelegalaid"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msafesolutions.legalaid",
      "config": {
        "googleMapsApiKey": "AIzaSyB8vnwKPf3OJgU2UqyivkRDPHhe9TmV0lI"
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Speak questions or save local voice evidence",
        "NSCameraUsageDescription": "Take your profile photo or complaint evidence",
        "NSPhotoLibraryUsageDescription": "Choose a profile photo or complaint evidence",
        "NSLocationWhenInUseUsageDescription": "Share your area with your guardian during Head Out"
      },
      "associatedDomains": [
        "applinks:bns-know-your-rights.emergent.host",
        "applinks:dhara-shield-2.preview.emergentagent.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#48627E"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.msafesolutions.legalaid",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB8vnwKPf3OJgU2UqyivkRDPHhe9TmV0lI"
        }
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bns-know-your-rights.emergent.host",
              "pathPrefix": "/guardian"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share your area with your guardian during Head Out",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dhara_logo_full.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#1A3F74"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/dhara_icon.png",
          "color": "#48627E",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}