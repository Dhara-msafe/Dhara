# Deployment supplies these as environment variables; do not commit backend/.env.
MONGO_URL=
DB_NAME=gandhikar_db
CORPUS_DB_NAME=dhara
EMERGENT_LLM_KEY=
JWT_SECRET=
EMERGENT_EMAIL_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_KEY=
# DHARA C1 — conversational replies (default OFF). See engine/conversational_intents.py.
FEATURE_C1_CONVERSATIONAL_REPLIES=false
# Google Places (New) — Head Out destination search pilot (default OFF).
# See api/geo_router.py. Server-side key only — never ship this to the client.
# No frontend rebuild needed to go live: destination.tsx and nearest-help.tsx
# already call these endpoints unconditionally and fail closed to OSM/external
# Maps today — setting both vars below and RESTARTING THE BACKEND PROCESS is
# the entire cutover (values are read once at import time, not per-request).
# Startup logs a one-line confirmation either way — see server.py's
# startup event. Verify with: python scripts/verify_google_places_config.py
FEATURE_GOOGLE_PLACES_V1=false
GOOGLE_PLACES_SERVER_KEY=
# Google Directions — Head Out live route/ETA (default OFF). See api/geo_router.py.
FEATURE_GOOGLE_DIRECTIONS_V1=false
GOOGLE_DIRECTIONS_SERVER_KEY=
